# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=kavach

# Redis
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# JWT (minimum 32 characters each)
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_ANOTHER_RANDOM_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Frontend
FRONTEND_URL=https://yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_DEV_INGESTION_MAX=30
RATE_LIMIT_RESEND_VERIFICATION_MAX=3

# Data encryption (required — min 32 chars)
DATA_ENCRYPTION_KEY=CHANGE_ME_MINIMUM_32_CHARACTERS_RANDOM_STRING

# Chamber key alias for Android key attestation
CHAMBER_KEY_ALIAS=kavach-chamber-key

# Bcrypt (optional — defaults to 12 salt rounds)
BCRYPT_SALT_ROUNDS=12

# Maps (optional)
MAPBOX_PUBLIC_TOKEN=pk.xxx

# Email (optional — password reset emails won't be sent without it)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=your-password
EMAIL_FROM=noreply@kavach.example.com

# Data retention (days) — DPDP purges run daily
RETENTION_LOCATION_DAYS=90
RETENTION_SCREEN_TIME_DAYS=365
RETENTION_AUDIT_DAYS=730

# Razorpay (required for subscriptions)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_PLAN_MONTHLY=plan_xxxxxxxxxxxxx
RAZORPAY_PLAN_YEARLY=plan_xxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Firebase (optional)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Admin panel access key (shared with admin-panel app; generate: openssl rand -hex 32)
ADMIN_ACCESS_KEY=CHANGE_ME_RANDOM_STRING
