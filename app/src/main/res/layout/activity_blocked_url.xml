<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/url_blocked_title"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#D32F2F"
        android:gravity="center" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/url_blocked_subtitle"
        android:textSize="16sp"
        android:textColor="#666666"
        android:gravity="center" />

    <TextView
        android:id="@+id/textBlockedUrl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textSize="14sp"
        android:textColor="#333333"
        android:textStyle="italic"
        android:gravity="center"
        android:padding="12dp"
        android:background="#FFFFFF" />

    <Button
        android:id="@+id/btnGoBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/url_go_back"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnRequestAccess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/url_request_access"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/textRequestStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="14sp"
        android:textColor="#388E3C"
        android:gravity="center"
        android:visibility="gone" />

</LinearLayout>
