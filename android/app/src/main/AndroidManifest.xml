<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Basic Networking & Sync -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Location (Geofencing & Tracking) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    
    <!-- Monitoring & Enforcement Permissions -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- Communication Sync Permissions -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    
    <!-- SMS Fallback for Emergency SOS -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    
    <!-- WiFi & Security Scan Permissions -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    
    <!-- Voice Command Permissions -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    
    <!-- Overlay permission for blocked-app overlay -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    
    <!-- DND policy permission for bedtime enforcement -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    
    <!-- URL filtering: AccessibilityService binds to inspect browser URL bars -->
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" />
    
    <!-- Boot & Background Consistency -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Lets the parent opt out of Doze so enforcement survives idle -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    
    <application
        android:name=".SafeGuardApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SafeGuard"
        tools:targetApi="34">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SafeGuard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- QR-code Device Owner provisioning (enterprise builds) -->
        <activity
            android:name=".provisioning.DeviceOwnerProvisioningActivity"
            android:exported="true"
            android:theme="@style/Theme.SafeGuard"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.app.action.PROVISION_MANAGED_DEVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Full-screen lock-screen overlay for parent approve/deny -->
        <activity
            android:name=".notifications.UnblockRequestOverlayActivity"
            android:exported="false"
            android:theme="@style/Theme.SafeGuard"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait" />

        <!-- Kiosk Mode activity (shown when device is locked) -->
        <activity
            android:name=".service.appblock.KioskActivity"
            android:exported="false"
            android:theme="@style/Theme.SafeGuard"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:stateNotNeeded="true"
            android:resumeWhilePausing="true"
            android:clearTaskOnLaunch="true"
            android:noHistory="true" />

        <!-- Device Admin Receiver for tamper-proofing and uninstall prevention -->
        <receiver
            android:name=".security.SafeGuardDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLED" />
            </intent-filter>
        </receiver>

        <!-- Foreground service that enforces app-blocking rules -->
        <service
            android:name=".service.appblock.AppBlockingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Parental control app-blocking enforcement" />
        </service>

        <!-- Periodic GPS pinger feeding the location dashboard -->
        <service
            android:name=".service.location.LocationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Geofence monitoring service -->
        <service
            android:name=".service.geofencing.GeofenceService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Voice command listening service -->
        <service
            android:name=".service.voice.VoiceCommandService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Rejects calls matching parent-defined BLOCK rules -->
        <service
            android:name=".service.contacts.CallScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- Receives server-initiated pushes (unblock decisions, blocks) -->
        <service
            android:name=".notifications.SafeGuardMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Restart enforcement after a reboot -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Overlay shown when a blocked app is launched -->
        <activity
            android:name=".service.appblock.BlockedAppOverlayActivity"
            android:exported="false"
            android:theme="@style/Theme.SafeGuard"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:documentLaunchMode="never"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!-- URL filter enforcement: foreground anchor for the accessibility service -->
        <service
            android:name=".service.urlfilter.UrlFilterService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Parental control URL filter enforcement" />
        </service>

        <!-- URL filter accessibility service: reads browser URL bars and blocks matches -->
        <service
            android:name=".service.urlfilter.UrlAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/url_filter_accessibility" />
        </service>

        <!-- Full-screen block screen shown when a URL matches a block rule -->
        <activity
            android:name=".service.urlfilter.BlockedUrlActivity"
            android:exported="false"
            android:theme="@style/Theme.SafeGuard"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:documentLaunchMode="never" />


    </application>
</manifest>
