{
  "name": "safeguard-backend",
  "version": "1.0.0",
  "description": "Backend for SafeGuard Parental Control App",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn src/server.ts",
    "build": "tsc",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns=integration",
    "test:integration": "jest integration --runInBand",
    "test:e2e": "cross-env RUN_E2E=1 jest tests/integration --runInBand --detectOpenHandles",
    "test:e2e:pgmem": "cross-env RUN_E2E=1 DB_DRIVER=pg-mem jest tests/integration --runInBand --detectOpenHandles",
    "db:migrate": "ts-node src/jobs/migrate.ts",
    "db:purge-tokens": "ts-node src/jobs/purgeRefreshTokens.ts",
    "db:seed": "ts-node src/jobs/seed.ts"
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.1",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "firebase-admin": "^12.7.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.5",
    "pg": "^8.11.3",
    "socket.io": "^4.7.2",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.11.0",
    "yaml": "^2.9.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.4",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^2.0.16",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "pg-mem": "^3.0.14",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
