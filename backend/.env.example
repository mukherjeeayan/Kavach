PORT=3000
NODE_ENV=development  # development | production | test

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_BEFORE_DEPLOYMENT
DB_NAME=kavach
# DB_DRIVER=pg          # pg (default) or pg-mem (in-memory for CI/testing)

# JWT — CHANGE THESE BEFORE DEPLOYMENT
JWT_SECRET=CHANGE_ME_BEFORE_DEPLOYMENT_use_64_char_random
JWT_REFRESH_SECRET=CHANGE_ME_BEFORE_DEPLOYMENT_use_64_char_random
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Redis (optional — rate limiting falls back to in-memory when unset
# or when Redis is unreachable)
# REDIS_URL=redis://localhost:6379

ALLOWED_ORIGINS=http://localhost:5173

# Firebase Cloud Messaging (optional — push notifications won't work without it)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Email (optional — password reset emails won't be sent without it)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your-password
# EMAIL_FROM=noreply@kavach.example.com
# FRONTEND_URL=http://localhost:5173

# Bcrypt (optional — defaults to 12 salt rounds)
# BCRYPT_SALT_ROUNDS=12

# Maps — served to the dashboard at runtime via GET /api/v1/geo/mapbox-token
# (never bake this into the frontend bundle)
# MAPBOX_PUBLIC_TOKEN=pk.xxx

# Data retention (days) — DPDP purges run daily by the in-process scheduler
# RETENTION_LOCATION_DAYS=90
# RETENTION_SCREEN_TIME_DAYS=365
# RETENTION_AUDIT_DAYS=730
